    "axios": "^1.13.2",
    "better-auth": "^1.3.9",
    "elysia": "latest",
    "fastest-levenshtein": "^1.0.16",
    "pg": "^8.16.3",
    "resend": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "bun-types": "latest",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "sequelize": "^6.37.7",
